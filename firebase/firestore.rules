rules_version = '2';
// Fixko: stranke oddajo dela (dela/{id}), mojstri z aktivno naročnino jih vidijo in prevzamejo.
// Prevzem, naročnino in brisanje izvajajo funkcije na strežniku (Admin SDK, mimo teh pravil).
service cloud.firestore {
  match /databases/{database}/documents {
    function prijavljen() { return request.auth != null; }
    function aktiven() {
      return prijavljen() && exists(/databases/$(database)/documents/mojstri/$(request.auth.uid))
        && get(/databases/$(database)/documents/mojstri/$(request.auth.uid)).data.get('narocninaDo', null) is timestamp
        && get(/databases/$(database)/documents/mojstri/$(request.auth.uid)).data.narocninaDo > request.time;
    }
    function besedilo(v, max) { return v is string && v.size() <= max; }

    // Ročni popravki stroke (opis brez osebnih podatkov) za izboljšanje prepoznave. Branje samo s strežnika.
    // Prijave neprimernih objav in mojstrov. Branje samo s strežnika.
    match /prijave/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['delo', 'kdo', 'razlog', 'prijavil', 'ustvarjeno'])
        && besedilo(request.resource.data.delo, 40) && request.resource.data.kdo in ['objava', 'mojster']
        && besedilo(request.resource.data.razlog, 60) && request.resource.data.prijavil == request.auth.uid
        && request.resource.data.ustvarjeno == request.time;
    }

    match /popravki/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['opis', 'predlog', 'izbrano', 'ustvarjeno'])
        && besedilo(request.resource.data.opis, 200) && besedilo(request.resource.data.predlog, 20)
        && besedilo(request.resource.data.izbrano, 20) && request.resource.data.ustvarjeno == request.time;
    }

    match /dela/{id} {
      allow read: if prijavljen() && (
        resource.data.lastnik == request.auth.uid
        || resource.data.get('mojster', null) == request.auth.uid
        || (resource.data.status == 'odprto' && aktiven()));
      allow create: if prijavljen()
        && !exists(/databases/$(database)/documents/blokirani/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['lastnik', 'stroka', 'opis', 'regija', 'kraj', 'kdaj', 'doma', 'budget', 'm2', 'slika', 'status', 'ustvarjeno'])
        && (!('m2' in request.resource.data) || (request.resource.data.m2 is int && request.resource.data.m2 >= 1 && request.resource.data.m2 <= 100000))
        && (!('doma' in request.resource.data) || (request.resource.data.doma is list && request.resource.data.doma.size() <= 4))
        && (!('budget' in request.resource.data) || besedilo(request.resource.data.budget, 20))
        && request.resource.data.lastnik == request.auth.uid
        && request.resource.data.status == 'odprto'
        && request.resource.data.ustvarjeno == request.time
        && besedilo(request.resource.data.stroka, 20) && besedilo(request.resource.data.regija, 10)
        && besedilo(request.resource.data.opis, 200) && besedilo(request.resource.data.kraj, 80) && besedilo(request.resource.data.kdaj, 20)
        && request.resource.data.kraj.size() > 0
        && besedilo(request.resource.data.slika, 600) && (request.resource.data.slika == '' || request.resource.data.slika.matches('(https://firebasestorage[.]googleapis[.]com|http://127[.]0[.]0[.]1:9199)/.*'));
      // Stranka lahko delo samo zaključi ali prekliče.
      allow update: if prijavljen() && resource.data.lastnik == request.auth.uid && ((
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['opravljeno', 'preklicano']
        && resource.data.status in ['odprto', 'prevzeto']
      ) || (
        // Dodatne slike (npr. ko mojster prosi zanje); prošnja se ob tem zapre.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slike', 'prosnja'])
        && request.resource.data.slike is list && request.resource.data.slike.size() <= 8
        && request.resource.data.get('prosnja', null) == null
      ));
      allow delete: if false;

      // Telefon stranke (in mojstra po prevzemu): vidita ga samo stranka in mojster, ki je delo prevzel.
      match /zasebno/kontakt {
        allow read: if prijavljen() && (resource.data.lastnik == request.auth.uid
          || get(/databases/$(database)/documents/dela/$(id)).data.get('mojster', null) == request.auth.uid);
        allow create: if prijavljen()
          && request.resource.data.keys().hasOnly(['lastnik', 'tel', 'push'])
          && request.resource.data.lastnik == request.auth.uid
          && besedilo(request.resource.data.tel, 20)
          && (request.resource.data.push == null || besedilo(request.resource.data.push, 200))
          && !exists(/databases/$(database)/documents/dela/$(id));
        allow update, delete: if false;
      }
    }

    // Ponudbe mojstrov (piše samo strežnik): vidita jih stranka in mojster, ki se je javil.
    match /ponudbe/{id} {
      allow read: if prijavljen() && (resource.data.lastnik == request.auth.uid || resource.data.mojster == request.auth.uid);
      allow write: if false;
    }

    // Profil mojstra: ime, podjetje, davčna (8 števk), slika iz naše shrambe, sprejeti pogoji.
    function profil(d) {
      return besedilo(d.ime, 60) && besedilo(d.tel, 20)
        && (!('firma' in d) || besedilo(d.firma, 80))
        && (!('davcna' in d) || (d.davcna is string && (d.davcna.matches('[1-9][0-9]{7}') || d.davcna == '')))
        && (!('slika' in d) || (besedilo(d.slika, 600) && d.slika.matches('(https://firebasestorage[.]googleapis[.]com|http://127[.]0[.]0[.]1:9199)/.*')))
        && (!('pogoji' in d) || besedilo(d.pogoji, 20));
    }
    match /mojstri/{uid} {
      allow read: if prijavljen() && request.auth.uid == uid;
      allow create: if prijavljen() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ime', 'firma', 'davcna', 'slika', 'pogoji', 'tel', 'stroke', 'regije', 'push', 'posodobljeno'])
        && profil(request.resource.data)
        && request.resource.data.stroke is list && request.resource.data.stroke.size() <= 20
        && request.resource.data.regije is list && request.resource.data.regije.size() <= 13;
      allow update: if prijavljen() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ime', 'firma', 'davcna', 'slika', 'pogoji', 'tel', 'stroke', 'regije', 'push', 'posodobljeno'])
        && profil(request.resource.data)
        && request.resource.data.stroke is list && request.resource.data.stroke.size() <= 20
        && request.resource.data.regije is list && request.resource.data.regije.size() <= 13;
      allow delete: if false;
    }

    // Ocene po opravljenem delu in povprečje na osebo. Vidijo jih vsi, piše samo strežnik (funkcija oceni).
    match /ocene/{id} {
      allow read: if prijavljen();
    }
    match /profili/{uid} {
      allow read: if prijavljen();
    }

    // Podatki za potrditveno nakazilo (IBAN, prejemnik). Piše samo strežnik.
    match /nastavitve/placilo {
      allow read: if prijavljen();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
