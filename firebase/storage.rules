rules_version = '2';
// Slike del: vsak nalaga samo v svojo mapo, samo slike do 8 MB. Branje prek povezave z žetonom (getDownloadURL).
service firebase.storage {
  match /b/{bucket}/o {
    match /slike/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    // Profilne slike mojstrov (nova datoteka ob vsaki zamenjavi).
    match /profil/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    // Potrdilo o registraciji tujega mojstra (slika ali PDF do 10 MB): bere ga samo lastnik (povezava) in strežnik.
    match /dokumenti/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
